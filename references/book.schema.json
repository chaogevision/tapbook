{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tapbook/book.schema.json",
  "title": "Interactive picture book",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "sourceLanguage",
    "translationLanguage",
    "voices",
    "readerTheme",
    "presentation",
    "pages"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "sourceLanguage": { "type": "string", "minLength": 2 },
    "translationLanguage": { "type": "string", "minLength": 2 },
    "voices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "zh": { "type": "string", "minLength": 1 }
      }
    },
    "readerTheme": { "$ref": "#/$defs/readerTheme" },
    "presentation": { "$ref": "#/$defs/presentation" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "readerTheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "source", "confidence", "reason"],
      "properties": {
        "preset": { "enum": ["winter", "vehicles", "construction", "ocean", "forest", "farm", "space", "storybook"] },
        "source": { "enum": ["auto", "user", "fallback"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "reason": { "type": "string", "minLength": 1 },
        "backgroundImage": { "type": "string", "minLength": 1 },
        "backgroundImagePortrait": { "type": "string", "minLength": 1 }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageMode"],
      "properties": {
        "pageMode": { "enum": ["single", "facing-pages", "source-spread"] }
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "lemma", "meaningZh", "box", "audio"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "lemma": { "type": "string", "minLength": 1 },
        "meaningZh": { "type": "string", "minLength": 1 },
        "box": { "$ref": "#/$defs/box" },
        "audio": { "type": "string", "minLength": 1 }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "start", "duration"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "start": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "sentence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wordStart", "wordEnd", "translationZh"],
      "properties": {
        "wordStart": { "type": "integer", "minimum": 0 },
        "wordEnd": { "type": "integer", "minimum": 1 },
        "translationZh": { "type": "string", "minLength": 1 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "sourcePdfPage",
        "image",
        "alt",
        "kind",
        "reviewStatus",
        "enText",
        "zhText",
        "words",
        "sentences",
        "englishAudio",
        "chineseAudio",
        "wordTimings"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "sourcePdfPage": { "type": "integer", "minimum": 1 },
        "image": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["cover", "title", "story", "illustration", "endpaper"]
        },
        "reviewStatus": { "enum": ["verified", "needs-review"] },
        "ocrWarnings": { "type": "array", "items": { "type": "string" } },
        "enText": { "type": "string" },
        "zhText": { "type": "string" },
        "words": {
          "type": "array",
          "items": { "$ref": "#/$defs/word" }
        },
        "sentences": {
          "type": "array",
          "items": { "$ref": "#/$defs/sentence" }
        },
        "englishAudio": { "type": ["string", "null"] },
        "chineseAudio": { "type": ["string", "null"] },
        "wordTimings": {
          "type": "array",
          "items": { "$ref": "#/$defs/timing" }
        }
      }
    }
  }
}
